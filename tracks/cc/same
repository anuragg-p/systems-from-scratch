#!/bin/sh
# same FILE: build FILE twice, with ./cc and with gcc for the same machine,
# run both on QEMU's bare RISC-V machine as ccrun does, and compare what they
# print and the status they exit with. Prints "same: status N" and exits 0,
# or prints both and "differ" and exits 1.
#
# The compiler under test is ./cc, or the one CC_UNDER_TEST names (a test
# hands it a broken one, to see that same notices).

here=$(cd "$(dirname "$0")" && pwd)
build=$here/build/same
ours=${CC_UNDER_TEST:-$here/cc}

if [ $# -ne 1 ]; then
  echo "usage: same FILE" >&2
  exit 2
fi
if [ ! -r "$1" ]; then
  echo "same: cannot open $1" >&2
  exit 2
fi

# The RISC-V tools: the first of these prefixes that has a gcc.
prefix=
for p in riscv64-elf- riscv64-unknown-elf- riscv64-linux-gnu-; do
  if command -v "${p}gcc" >/dev/null 2>&1; then
    prefix=$p
    break
  fi
done
if [ -z "$prefix" ]; then
  echo "same: no RISC-V gcc (riscv64-elf-gcc, riscv64-unknown-elf-gcc or riscv64-linux-gnu-gcc): install the riscv64 toolchain" >&2
  exit 2
fi
if ! command -v qemu-system-riscv64 >/dev/null 2>&1; then
  echo "same: no qemu-system-riscv64: install QEMU" >&2
  exit 2
fi

mkdir -p "$build" || exit 2

# @build 00.03 the same program from gcc
# Build the program with the compiler under test as ccrun does, into
# build/same/ours.elf. Build it with ${prefix}gcc too (-O0, for rv64im and
# lp64, freestanding: no C library, no built-in functions, no linker
# relaxation), linked with the same rt/start.S and rt/link.ld, into
# build/same/gcc.elf. Run each on QEMU with no input, keeping what it
# prints and its status. If both agree, print "same: status N" and exit 0;
# else print each one's status and output, then "differ", and exit 1.
"$ours" -o "$build/ours.s" "$1" || exit 2
"${prefix}as" -march=rv64im -mabi=lp64 -o "$build/start.o" "$here/rt/start.S" || exit 2
"${prefix}as" -march=rv64im -mabi=lp64 -o "$build/ours.o" "$build/ours.s" || exit 2
"${prefix}ld" -T "$here/rt/link.ld" -o "$build/ours.elf" "$build/start.o" "$build/ours.o" || exit 2

# The file is one expression, not yet a C program, so for gcc it goes into
# a main that returns it. (When the input is a whole C program, this goes.)
{ printf 'int main(void) { return '; cat "$1"; printf '\n; }\n'; } > "$build/gcc.c"
"${prefix}gcc" -O0 -march=rv64im -mabi=lp64 -mcmodel=medany -fno-pie \
  -ffreestanding -nostdlib -fno-builtin -mno-relax \
  -c -o "$build/gcc.o" "$build/gcc.c" || exit 2
"${prefix}ld" -T "$here/rt/link.ld" -o "$build/gcc.elf" "$build/start.o" "$build/gcc.o" || exit 2

qemu() {
  qemu-system-riscv64 -machine virt -bios none -display none -monitor none \
    -serial stdio -kernel "$1" </dev/null
}
qemu "$build/ours.elf" > "$build/ours.out"
ours_status=$?
qemu "$build/gcc.elf" > "$build/gcc.out"
gcc_status=$?

if [ "$ours_status" -eq "$gcc_status" ] && cmp -s "$build/ours.out" "$build/gcc.out"; then
  echo "same: status $ours_status"
  exit 0
fi
echo "ours: status $ours_status"
if [ -s "$build/ours.out" ]; then
  echo "ours printed:"
  cat "$build/ours.out"
fi
echo "gcc: status $gcc_status"
if [ -s "$build/gcc.out" ]; then
  echo "gcc printed:"
  cat "$build/gcc.out"
fi
echo "differ"
exit 1
# @end
